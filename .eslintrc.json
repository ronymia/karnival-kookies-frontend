{
  "extends": ["next", "next/core-web-vitals", "eslint:recommended"],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": ["promise", "react"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "promise/catch-or-return": "error"
  }
}
